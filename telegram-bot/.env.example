# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_key_here

# Groq API Key (optional, get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_key_here

# AI Provider (openai or groq)
AI_PROVIDER=openai

# Database file path
DATABASE_PATH=./database/oowell.db

# Authorized phone numbers (comma separated)
AUTHORIZED_PHONES=060456690,069123456,078987654

# Bot settings
MAX_PHONE_ATTEMPTS=3
MESSAGE_BATCH_TIMEOUT=5000
